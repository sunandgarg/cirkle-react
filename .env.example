# Local MySQL (also consumed by docker-compose.yml)
MYSQL_DATABASE=cirkle
MYSQL_USER=cirkle
MYSQL_PASSWORD=cirkle_local_only_change_me
MYSQL_ROOT_PASSWORD=cirkle_local_root_change_me
MYSQL_PORT=3306
DATABASE_URL=mysql://cirkle:cirkle_local_only_change_me@127.0.0.1:3306/cirkle

# Node API
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=0
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
APP_BASE_URL=http://localhost:3001
FRONTEND_URL=http://localhost:8080
DEFAULT_COMMUNITY_ID=iit-community
LOG_LEVEL=debug

# Authentication. These values are deliberately local-only.
JWT_ACCESS_SECRET=local-dev-access-secret-change-before-production-0001
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-before-production-0002
JWT_ISSUER=cirkle-api
JWT_AUDIENCE=cirkle-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=365
COOKIE_SECURE=false
IP_HASH_SECRET=local-dev-ip-hash-secret-change-before-production
OTP_PEPPER=local-dev-otp-pepper-change-before-production

# Zoho ZeptoMail REST API. Keep the Agent Send Mail token server-side; SMTP
# credentials are not used by this application.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_FROM_EMAIL=noreply@cirkle.world
ZEPTOMAIL_FROM_NAME=Cirkle

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Server-only AI credentials
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# GIF search and Daily audio/video calls
KLIPY_API_KEY=
DAILY_API_KEY=
DAILY_DOMAIN=

# Optional locally. Socket.IO remains the zero-AWS development fallback.
APPSYNC_ENABLED=false
APPSYNC_HTTP_ENDPOINT=
APPSYNC_PUBLISH_TOKEN=
APPSYNC_AUTHORIZER_SECRET=
APPSYNC_PUBLISH_TIMEOUT_MS=4000

# Private file storage
STORAGE_ROOT=./.local/storage
STORAGE_SIGNING_SECRET=local-dev-storage-signing-secret-change-before-production
MAX_UPLOAD_BYTES=20971520

# Development phone verification is disabled unless explicitly enabled.
MOBILE_TEST_MODE=false
MOBILE_TEST_PHONES=
ENABLE_SEED_DATA=false

# Optional one-time owner seed
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME='Platform Owner'
SEED_ADMIN_IIT='IIT Delhi'
SEED_ADMIN_DEGREE=BTech
SEED_ADMIN_SPECIALISATION='Computer Science & Engineering'
SEED_ADMIN_PASSING_YEAR=2026
SEED_ADMIN_PHONE_COUNTRY_CODE=+91
SEED_ADMIN_PHONE_NUMBER=9999999999

# Browser-visible build values. Never put a secret in a VITE_ variable.
VITE_API_URL=
VITE_CHAT_REALTIME_PROVIDER=socketio
VITE_APPSYNC_HTTP_ENDPOINT=
VITE_APPSYNC_REALTIME_ENDPOINT=
VITE_DAILY_CALLS_ENABLED=true

# Backup helper. A dedicated, least-privilege MySQL user is recommended.
MYSQL_BACKUP_HOST=127.0.0.1
MYSQL_BACKUP_PORT=3306
MYSQL_BACKUP_DATABASE=cirkle
MYSQL_BACKUP_USER=cirkle
MYSQL_BACKUP_PASSWORD=cirkle_local_only_change_me
MYSQL_BACKUP_DIR=./.local/backups/mysql
MYSQL_BACKUP_RETENTION_DAYS=0
