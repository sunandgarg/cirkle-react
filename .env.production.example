# Copy to /etc/cirkle/api.env on the API host. Keep that file out of Git,
# owned by root:cirkle, and mode 0640. Blank secrets intentionally fail startup.

NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY_HOPS=1
DATABASE_URL=
CORS_ORIGINS=https://cirkle.world,https://www.cirkle.world
APP_BASE_URL=https://api.cirkle.world
FRONTEND_URL=https://cirkle.world
DEFAULT_COMMUNITY_ID=iit-community
LOG_LEVEL=info

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=cirkle-api
JWT_AUDIENCE=cirkle-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Omit COOKIE_DOMAIN for a safer host-only refresh cookie.
COOKIE_SECURE=true
IP_HASH_SECRET=
OTP_PEPPER=

ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_EMAIL=verify@cirkle.world
ZEPTOMAIL_FROM_NAME=Cirkle

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.cirkle.world/api/auth/google/callback

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

KLIPY_API_KEY=
DAILY_API_KEY=
# Optional fallback such as your-team.daily.co; no scheme or path.
DAILY_DOMAIN=

STORAGE_ROOT=/srv/cirkle/shared/storage
STORAGE_SIGNING_SECRET=
MAX_UPLOAD_BYTES=20971520
MOBILE_TEST_MODE=false
MOBILE_TEST_PHONES=
ENABLE_SEED_DATA=false

# MySQL administration, backups, one-time seed credentials, and browser build
# variables deliberately live in separate protected/configuration files. The
# long-running Node process must receive only the values it actually needs.
