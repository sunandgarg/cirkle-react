# Copy to /etc/cirkle/mysql.env, set root:root ownership and mode 0600, and use
# it only with root-run Docker/MySQL administration. Neither Node nor the
# `cirkle` service account should be able to read this file.

MYSQL_DATABASE=cirkle
MYSQL_USER=cirkle
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
