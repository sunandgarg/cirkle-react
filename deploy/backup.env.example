# Copy to /etc/cirkle/backup.env, set root:cirkle ownership and mode 0640.
# This contains only a dedicated least-privilege backup account. The Node API
# never loads it, and it must never contain the MySQL root password.

MYSQL_BACKUP_HOST=127.0.0.1
MYSQL_BACKUP_PORT=3306
MYSQL_BACKUP_DATABASE=cirkle
MYSQL_BACKUP_USER=cirkle_backup
MYSQL_BACKUP_PASSWORD=
MYSQL_BACKUP_DIR=/var/backups/cirkle/mysql
MYSQL_BACKUP_RETENTION_DAYS=30
