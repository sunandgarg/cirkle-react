# Install the real file at /etc/cirkle/migration.env as root:root mode 0600.
# URL-encode the distinct cirkle_migrate password. Never give this URL to the
# long-running API service or backup timer.
MIGRATION_DATABASE_URL="mysql://cirkle_migrate:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_PRIVATE_LIGHTSAIL_DATABASE_HOST.rds.amazonaws.com:3306/cirkle?sslcert=%2Fetc%2Fcirkle%2Fmysql-ca.pem&sslaccept=strict&connection_limit=1"
