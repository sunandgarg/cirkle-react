# Install the real file at /etc/cirkle/backup.env as root:root mode 0600.
# cirkle_backup is read-only and distinct from runtime and migration users.
BACKUP_DATABASE_URL="mysql://cirkle_backup:REPLACE_WITH_URL_ENCODED_PASSWORD@REPLACE_WITH_PRIVATE_LIGHTSAIL_DATABASE_HOST.rds.amazonaws.com:3306/cirkle?sslcert=%2Fetc%2Fcirkle%2Fmysql-ca.pem&sslaccept=strict&connection_limit=1"
DATABASE_CA_FILE=/etc/cirkle/mysql-ca.pem
AWS_REGION=ap-south-1
BACKUP_BUCKET=REPLACE_WITH_PRIVATE_BACKUP_BUCKET
AWS_ACCESS_KEY_ID=REPLACE_WITH_BACKUP_ONLY_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_BACKUP_ONLY_SECRET_KEY
