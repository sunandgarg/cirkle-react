# Copy outside the repository, replace placeholders, chmod 0600, and source only
# for the one-time/idempotent setup-lightsail-db.sh provisioning command.
DB_HOST=REPLACE_WITH_PRIVATE_LIGHTSAIL_DATABASE_HOST.rds.amazonaws.com
DB_MASTER_USER=REPLACE_WITH_MASTER_USERNAME
DB_MASTER_PASSWORD_FILE=/root/cirkle-db-master.password
DB_APP_PASSWORD_FILE=/root/cirkle-db-app.password
DB_MIGRATION_PASSWORD_FILE=/root/cirkle-db-migration.password
DB_BACKUP_PASSWORD_FILE=/root/cirkle-db-backup.password
DB_CA_FILE=/etc/cirkle/mysql-ca.pem
