# Public Cloudflare Pages build variables. Never put server secrets here.
VITE_API_URL=https://api-react.cirkle.world
VITE_CHAT_REALTIME_PROVIDER=socketio
# Keep false until the API's protected environment contains DAILY_API_KEY and
# GET /api/features reports daily_calls=true. Both gates must pass.
VITE_DAILY_CALLS_ENABLED=false
PNPM_VERSION=11.19.0
